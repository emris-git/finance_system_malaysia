# --- Core -------------------------------------------------------------------
# Railway injects DATABASE_URL from the Postgres service (postgresql://...).
DATABASE_URL=postgresql://finance:finance@localhost:55432/finance
# Signs dashboard login links and cookies. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
# Bearer token for machine endpoints (/api/imports, /api/events): CLI, iOS Shortcut, the categorization agent.
API_TOKEN=change-me-too
TZ_NAME=Asia/Kuala_Lumpur

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (ask @userinfobot). Only this user can talk to the bot.
TELEGRAM_OWNER_ID=
# Public https URL of the API service; enables webhook mode and dashboard links.
PUBLIC_BASE_URL=
# Required for the webhook: random letters, digits, _ and - (Telegram's rule). Telegram echoes it
# back in X-Telegram-Bot-Api-Secret-Token; without it the webhook is not registered and the bot is silent.
TELEGRAM_WEBHOOK_SECRET=

# --- Statement passwords ----------------------------------------------------
TNG_PDF_PASSWORD=
MAYBANK_PDF_PASSWORD=

# --- Scheduler --------------------------------------------------------------
# Runs weekly and monthly reports inside the API process.
SCHEDULER_ENABLED=true
# First day of the financial month. Salary on the 25th -> months run 26th..25th
# and the monthly report arrives on the 26th. 1 = calendar months.
MONTH_START_DAY=26

# --- SSH host of the Apple Pay automation (only these two are needed there) --
# `finance event` posts card payments to the deployed API instead of the DB.
FINANCE_API_URL=
